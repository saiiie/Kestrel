# Use a JDBC URL, not a postgres:// URL. Never commit real credentials.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/kestrel
SPRING_DATASOURCE_USERNAME=kestrel
SPRING_DATASOURCE_PASSWORD=replace-with-local-database-password
# Generate separate random secrets. JWT: at least 32 ASCII bytes.
# AES key: exactly 16, 24, or 32 ASCII bytes; keep it stable for existing data.
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
ENCRYPTION_SECRET=replace-with-32-random-characters
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=guest
SPRING_RABBITMQ_PASSWORD=guest
COINGECKO_API_KEY=
# 15-second polling for the portfolio demo, shared by all users and assets.
PRICE_POLL_INTERVAL_MS=15000
