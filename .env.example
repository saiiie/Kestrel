# Used by Docker Compose. Replace all secret placeholders before running.
POSTGRES_PASSWORD=replace-with-a-random-database-password
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
ENCRYPTION_SECRET=replace-with-32-random-characters
RABBITMQ_USER=kestrel
# Use a random hexadecimal value so it is also safe in the AMQP URL.
RABBITMQ_PASSWORD=replace-with-a-random-hex-password
COINGECKO_API_KEY=
PRICE_POLL_INTERVAL_MS=15000
# Local: http://localhost. Production: your actual DNS hostname, without scheme.
SITE_ADDRESS=http://localhost
FRONTEND_URL=http://localhost
